generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──────────────────────────────────────────────────────────────────

enum UserPlan {
  FREE
  TRIAL
  PAID
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

enum PracticeMode {
  HUMAN_AI
  HUMAN_HUMAN
  AI_TEACHER
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum CallRating {
  POOR
  AVERAGE
  GOOD
  EXCELLENT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum ProgressCategory {
  GRAMMAR
  VOCABULARY
  PRONUNCIATION
}

enum ScenarioDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id                   String            @id @default(uuid()) @db.Uuid
  displayName          String            @map("display_name") @db.VarChar(100)
  avatarColor          String?           @default("#6C5CE7") @map("avatar_color") @db.VarChar(7)
  avatarUrl            String?           @map("avatar_url")
  email                String            @unique @db.VarChar(255) // Encrypted at application layer
  emailHash            String            @unique @map("email_hash") // Blind index for lookups
  passwordHash         String?           @map("password_hash") @db.VarChar(255)
  
  googleId             String?           @unique @map("google_id")
  appleId              String?           @unique @map("apple_id")
  
  nativeLanguage       String            @default("ta") @map("native_language") @db.VarChar(10)
  englishLevel         Int               @default(1) @map("english_level") @db.SmallInt // 1-10
  profession           String?           @db.VarChar(100)
  interests            String[]
  locationCity         String?           @map("location_city") @db.VarChar(100)
  locationState        String?           @map("location_state") @db.VarChar(100)
  
  xpTotal              Int               @default(0) @map("xp_total")
  streakDays           Int               @default(0) @map("streak_days")
  streakLastAt         DateTime?         @map("streak_last_at")
  streakSaversRemaining Int              @default(2) @map("streak_savers_remaining") @db.SmallInt
  
  plan                 UserPlan          @default(TRIAL)
  planExpiresAt        DateTime?         @map("plan_expires_at")
  
  razorpayCustomerId   String?           @map("razorpay_customer_id") @db.VarChar(50)
  stripeCustomerId     String?           @map("stripe_customer_id") @db.VarChar(50)
  
  callRating           CallRating        @default(AVERAGE) @map("call_rating")
  isDiscoverable       Boolean           @default(true) @map("is_discoverable")
  isBanned             Boolean           @default(false) @map("is_banned")
  
  lastSeenAt           DateTime?         @map("last_seen_at")
  fcmToken             String?           @map("fcm_token")
  deviceInfo           Json?             @map("device_info")
  preferences          Json              @default("{}")
  
  emailVerified        Boolean           @default(false) @map("email_verified")
  verificationToken    String?           @map("verification_token")
  
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  // Relations
  subscriptions        Subscription[]
  practiceSessions     PracticeSession[] @relation("UserSessions")
  partnerSessions      PracticeSession[] @relation("PartnerSessions")
  corrections          SessionCorrection[]
  sessionWords         SessionWord[]
  leagueEntries        LeagueEntry[]
  achievements         Achievement[]
  hostedRooms          CommunityRoom[]   @relation("HostRooms")
  roomParticipations   RoomParticipant[]
  requestedConnections PartnerConnection[] @relation("Requester")
  targetConnections    PartnerConnection[] @relation("Target")
  userProgress         UserProgress[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([plan, planExpiresAt])
  @@index([isDiscoverable, englishLevel])
}

model Subscription {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @map("user_id") @db.Uuid
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan                    SubscriptionPlan
  amountPaise             Int                @map("amount_paise")
  currency                String             @default("INR") @db.VarChar(3)
  
  razorpaySubscriptionId  String?            @unique @map("razorpay_subscription_id") @db.VarChar(100)
  stripeSubscriptionId    String?            @unique @map("stripe_subscription_id") @db.VarChar(100)
  
  status                  SubscriptionStatus @default(TRIALING)
  trialEnd                DateTime?          @map("trial_end")
  currentPeriodStart      DateTime?          @map("current_period_start")
  currentPeriodEnd        DateTime?          @map("current_period_end")
  cancelledAt             DateTime?          @map("cancelled_at")
  
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
}

model PracticeSession {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  user                 User              @relation("UserSessions", fields: [userId], references: [id])
  
  mode                 PracticeMode
  partnerId            String?           @map("partner_id") @db.Uuid
  partner              User?             @relation("PartnerSessions", fields: [partnerId], references: [id])
  
  scenarioName         String?           @map("scenario_name") @db.VarChar(100)
  aiCharacter          String?           @map("ai_character") @db.VarChar(50)
  language             String            @default("en") @db.VarChar(10)
  level                Int?              @db.SmallInt
  
  messages             Json[]            // [{ role, content, timestamp, corrections: [] }]
  
  grammarScore         Decimal?          @map("grammar_score") @db.Decimal(5, 2)
  pronunciationScore   Decimal?          @map("pronunciation_score") @db.Decimal(5, 2)
  fluencyScore         Decimal?          @map("fluency_score") @db.Decimal(5, 2)
  
  xpEarned             Int               @default(0) @map("xp_earned")
  trophiesEarned       Int               @default(0) @map("trophies_earned")
  
  feedbackJson         Json?             @map("feedback_json")
  durationSeconds      Int?              @map("duration_seconds")
  endedAt              DateTime?         @map("ended_at")
  
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  corrections          SessionCorrection[]
  sessionWords         SessionWord[]

  @@index([userId, mode, endedAt])
  @@index([partnerId])
}

model SessionCorrection {
  id              String          @id @default(uuid()) @db.Uuid
  sessionId       String          @map("session_id") @db.Uuid
  session         PracticeSession @relation(fields: [sessionId], references: [id])
  userId          String          @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id])
  
  originalText    String          @map("original_text") @db.Text
  correctedText   String          @map("corrected_text") @db.Text
  errorType       String          @map("error_type") @db.VarChar(100)
  explanation     String          @db.Text
  severity        Severity        @default(LOW)
  wasSaved        Boolean         @default(false) @map("was_saved")
  
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([userId, errorType])
}

model SessionWord {
  id              String          @id @default(uuid()) @db.Uuid
  sessionId       String          @map("session_id") @db.Uuid
  session         PracticeSession @relation(fields: [sessionId], references: [id])
  userId          String          @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id])
  
  word            String          @db.VarChar(200)
  timesUsed       Int             @default(0) @map("times_used") @db.SmallInt
  goal            Int             @default(3) @db.SmallInt
  completed       Boolean         @default(false)
  
  createdAt       DateTime        @default(now()) @map("created_at")
}

model WordOfDay {
  id              String          @id @default(uuid()) @db.Uuid
  word            String          @db.VarChar(200)
  definition      String?         @db.Text
  exampleSentence String?         @map("example_sentence") @db.Text
  language        String          @default("en") @db.VarChar(10)
  audioUrl        String?         @map("audio_url") @db.Text
  dateShown       DateTime        @map("date_shown") @db.Date
  difficulty      Int?            @db.SmallInt
  
  createdAt       DateTime        @default(now()) @map("created_at")

  @@unique([dateShown, language])
}

model LeagueEntry {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id])
  
  tier            LeagueTier      @default(BRONZE)
  trophies        Int             @default(0)
  weekStart       DateTime        @map("week_start") @db.Date
  weekEnd         DateTime        @map("week_end") @db.Date
  rank            Int?
  promoted        Boolean?
  demoted         Boolean?
  
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
  @@index([tier, trophies])
}

model Achievement {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id])
  
  type            String          @db.VarChar(50)
  label           String          @db.VarChar(100)
  icon            String          @db.VarChar(50)
  xpReward        Int             @default(0) @map("xp_reward")
  earnedAt        DateTime        @default(now()) @map("earned_at")
  metadata        Json?
  
  createdAt       DateTime        @default(now()) @map("created_at")
}

model CommunityRoom {
  id                String            @id @default(uuid()) @db.Uuid
  name              String            @db.VarChar(100)
  topic             String?           @db.VarChar(100)
  language          String?           @db.VarChar(10)
  levelMin          Int?              @map("level_min") @db.SmallInt
  levelMax          Int?              @map("level_max") @db.SmallInt
  isLive            Boolean           @default(false) @map("is_live")
  isPublic          Boolean           @default(true) @map("is_public")
  
  hostId            String            @map("host_id") @db.Uuid
  host              User              @relation("HostRooms", fields: [hostId], references: [id])
  
  maxParticipants   Int               @default(20) @map("max_participants") @db.SmallInt
  startedAt         DateTime?         @map("started_at")
  endedAt           DateTime?         @map("ended_at")
  
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  participants      RoomParticipant[]

  @@index([isLive, language])
}

model RoomParticipant {
  id              String          @id @default(uuid()) @db.Uuid
  roomId          String          @map("room_id") @db.Uuid
  room            CommunityRoom   @relation(fields: [roomId], references: [id])
  userId          String          @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id])
  
  joinedAt        DateTime        @default(now()) @map("joined_at")
  leftAt          DateTime?       @map("left_at")

  @@unique([roomId, userId])
}

model PartnerConnection {
  id              String            @id @default(uuid()) @db.Uuid
  requesterId     String            @map("requester_id") @db.Uuid
  requester       User              @relation("Requester", fields: [requesterId], references: [id])
  targetId        String            @map("target_id") @db.Uuid
  target          User              @relation("Target", fields: [targetId], references: [id])
  
  status          ConnectionStatus  @default(PENDING)
  sessionId       String?           @map("session_id") @db.Uuid
  
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
}

model AICharacter {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @db.VarChar(100)
  persona          String          @db.Text
  voiceId          String?         @map("voice_id") @db.VarChar(50) // For AWS Polly
  avatarImageUrl   String?         @map("avatar_image_url") @db.Text
  scenarioCategory String?         @map("scenario_category") @db.VarChar(100)
  difficulty       Int?            @db.SmallInt
  systemPrompt     String          @map("system_prompt") @db.Text
  isActive         Boolean         @default(true) @map("is_active")
  usageCount       Int             @default(0) @map("usage_count")
  
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  scenarios        ScenarioConfig[]
}

model ScenarioConfig {
  id              String              @id @default(uuid()) @db.Uuid
  characterId     String              @map("character_id") @db.Uuid
  character       AICharacter         @relation(fields: [characterId], references: [id])
  
  name            String              @db.VarChar(200)
  description     String?             @db.Text
  category        String?             @db.VarChar(100)
  difficulty      ScenarioDifficulty  @default(INTERMEDIATE)
  participantCount Int                @default(0) @map("participant_count")
  thumbnailUrl    String?             @map("thumbnail_url") @db.Text
  isActive        Boolean             @default(true) @map("is_active")
  
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
}

model UserProgress {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  user            User              @relation(fields: [userId], references: [id])
  
  topic           String            @db.VarChar(100)
  category        ProgressCategory
  score           Decimal           @db.Decimal(5, 2)
  sessionsCount   Int               @default(0) @map("sessions_count")
  lastPracticedAt DateTime?         @map("last_practiced_at")
  
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([userId, topic])
}

model AuditLog {
  id              String          @id @default(uuid()) @db.Uuid
  actorId         String?         @map("actor_id") @db.Uuid
  actor           User?           @relation(fields: [actorId], references: [id])
  
  action          String          @db.VarChar(100)
  targetType      String          @map("target_type") @db.VarChar(50)
  targetId        String?         @map("target_id") @db.Uuid
  metadata        Json?
  ipAddress       String?         @map("ip_address") @db.VarChar(45)
  
  performedAt     DateTime        @default(now()) @map("performed_at")
}
